{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptex-x.local/schemas/cryptex_envelope.schema.json",
  "title": "Cryptex RFQ envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["$meta", "rfq"],
  "properties": {
    "$meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "security_context"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "security_context": {
          "$ref": "security_context.schema.json"
        }
      }
    },
    "rfq": {
      "type": "object",
      "additionalProperties": true,
      "required": ["intent", "instrument"],
      "properties": {
        "intent": {
          "type": "string",
          "enum": ["enterprise_sync", "kem_analysis", "local"]
        },
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "price_print_usd_mt": {
          "type": "number"
        },
        "price_print_ts": {
          "type": "string",
          "description": "ISO-8601 timestamp of the market print"
        },
        "incoterms": {
          "type": ["string", "null"]
        },
        "payment_escrow": {
          "type": ["boolean", "null"]
        }
      }
    }
  }
}
